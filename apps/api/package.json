{
  "name": "@setpoint/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@prisma/client": "^7.10.1",
    "dotenv": "^18.0.10",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "prisma": "^7.10.1",
    "tsx": "^4.20.0",
    "typescript": "~5.7.2"
  },
  "overrides": {
    "@prisma/config": {
      "effect": "3.22.1"
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true
  }
